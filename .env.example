# Set this to the public HTTPS URL if the installer is hosted separately.
ORCA_WINDOWS_DOWNLOAD_URL=

# Server-only PIA Engine credentials for live market API routes (/api/market/*).
# Copy to .env.local (never commit .env.local or expose PIA_API_KEY to the browser).
PIA_API_KEY=
PIA_BASE_URL=https://api-engine.wign.dev
PIA_WS_URL=wss://api-engine.wign.dev/api/v1/ws
